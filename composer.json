{
    "name": "webrek/laravel-mongo-permission",
    "description": "Role and permission management for Laravel with a MongoDB backend",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mongodb",
        "permissions",
        "roles",
        "rbac",
        "acl",
        "authorization",
        "multi-tenant",
        "wildcard"
    ],
    "support": {
        "issues": "https://github.com/webrek/laravel-mongo-permission/issues",
        "source": "https://github.com/webrek/laravel-mongo-permission"
    },
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0",
        "illuminate/container": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "mongodb/laravel-mongodb": "^5.0"
    },
    "require-dev": {
        "infection/infection": "^0.29",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Webrek\\MongoPermission\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webrek\\MongoPermission\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webrek\\MongoPermission\\MongoPermissionServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
